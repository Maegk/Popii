# Application
APP_NAME=Creative Fatigue Detection System
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/creative_fatigue
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Meta (Facebook) Ads API
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=act_123456789
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_API_VERSION=v19.0

# Anthropic API (for creative generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI API (alternative for creative generation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Creative Generation Settings
CREATIVE_GENERATOR=anthropic  # Options: anthropic, openai
CREATIVE_VARIATIONS_PER_REQUEST=5
CREATIVE_GENERATION_TIMEOUT=60

# Fatigue Detection Thresholds
FATIGUE_FREQUENCY_THRESHOLD=6
FATIGUE_CTR_DROP_PERCENT=20
FATIGUE_CPA_INCREASE_PERCENT=25
FATIGUE_ENGAGEMENT_DROP_PERCENT=30
MIN_IMPRESSIONS_FOR_ANALYSIS=1000
MIN_DAYS_FOR_ANALYSIS=3

# Prediction Settings
PREDICTION_LOOKAHEAD_DAYS=3
PREDICTION_CONFIDENCE_THRESHOLD=0.7
PREDICTION_MODEL=gradient_boosting  # Options: gradient_boosting, random_forest, prophet

# Monitoring Settings
METRICS_COLLECTION_INTERVAL_MINUTES=60
METRICS_RETENTION_DAYS=90
ENABLE_REAL_TIME_MONITORING=true

# Auto-Rotation Settings
ENABLE_AUTO_ROTATION=true
AUTO_ROTATION_FATIGUE_THRESHOLD=0.7
AUTO_ROTATION_COOLDOWN_HOURS=24
MAX_ACTIVE_CREATIVES_PER_ADSET=3

# Learning Engine
ENABLE_LEARNING_ENGINE=true
LEARNING_UPDATE_INTERVAL_HOURS=6
MIN_SAMPLES_FOR_LEARNING=100

# Security
SECRET_KEY=your_secret_key_here_change_in_production
API_KEY=your_api_key_for_authentication
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Monitoring & Observability
SENTRY_DSN=your_sentry_dsn_here
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Feature Flags
ENABLE_WEBHOOK_NOTIFICATIONS=false
ENABLE_SLACK_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false

# Slack (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_CHANNEL=#ad-performance

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password
EMAIL_FROM=noreply@yourcompany.com
